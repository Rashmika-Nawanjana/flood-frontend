# ============================================
# FloodSense LK — Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# API Gateway (Group A2 backend — gateway TBD)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Socket.IO Server (Member 4)
# Socket.IO handles ws:// upgrade internally — use http:// here
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Keycloak SSO (Group A4 — not started yet)
# Leave these empty to use dev bypass mode
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
NEXTAUTH_SECRET=dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

