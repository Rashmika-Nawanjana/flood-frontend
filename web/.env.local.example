# ============================================
# FloodSense LK — Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# Environment (development, staging, production)
NEXT_PUBLIC_ENVIRONMENT=development

# API Gateway - Update based on environment
# Development: http://localhost:8000/api
# Staging: https://api-stg.flodsense.lk/api
# Production: https://api.flodsense.lk/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Socket.IO Server (Member 4)
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws/live

# Clerk Auth - Get from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
# JWT template name from Clerk dashboard (JWT Templates → your template name).
# Required so getToken() returns a token that includes publicMetadata (role).
# Without this, all users will appear as "citizen" to the backend.
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=flood-app

# Optional if you want to point Clerk at a public dev tunnel or custom domain
# NEXT_PUBLIC_CLERK_PROXY_URL=

# ngrok - Get token from https://dashboard.ngrok.com (development only)
NGROK_AUTHTOKEN=

# Mapbox (Member 3) - Optional
NEXT_PUBLIC_MAPBOX_TOKEN=
