# ============================================
# FloodSense LK - Environment Variables
# Copy this file to .env.local and fill in values.
# ============================================

# Public client config
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws/live
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Auth and session config
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
NEXTAUTH_SECRET=dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Server-only map services
MAPBOX_DIRECTIONS_TOKEN=sk.your_mapbox_secret_token_here
